# Servicio de conteo para un VPS chico (sin la etapa de torch, que pide más memoria de la que hay).
# El modelo RF-DETR ya exportado se pone en models/rfdetr-nano.onnx antes de construir (respaldo de Railway o
# descarga del servicio en Railway mientras siga encendido).
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
 && pip uninstall -y opencv-python \
 && pip install --no-cache-dir --force-reinstall --no-deps opencv-python-headless==4.10.0.84
COPY models/rfdetr-nano.onnx /app/models/rfdetr-nano.onnx
COPY conteo.py app.py ./
ENV PORT=8080 MODELOS=/app/models/rfdetr-nano.onnx
CMD uvicorn app:app --host 0.0.0.0 --port ${PORT}
