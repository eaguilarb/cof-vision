# Copia este archivo a ".env" (mismo directorio) y completa los valores
# reales. Nunca subas el ".env" real a git (ya está en .gitignore).

# Cuenta de administrador del CRM (no de la intranet)
ADMIN_EMAIL=admin@tuempresa.cl
ADMIN_NAME=Tu Nombre
ADMIN_PASSWORD=cambia-esto

# Clave propia para firmar los tokens de sesión del CRM — genera una
# aleatoria, por ejemplo con: openssl rand -hex 32
JWT_SECRET=

# Deja estas dos vacías para correr en modo local/demo (datos de
# ejemplo, no toca la intranet real). Complétalas solo cuando quieras
# conectar la intranet real de la empresa.
INTRANET_EMAIL=
INTRANET_PASSWORD=

# Opcional — correo al resolver un caso (ver backend/README.md)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
