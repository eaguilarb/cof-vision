# ---------- Telegram ----------
# Token que te da @BotFather
TELEGRAM_BOT_TOKEN=
# api_id y api_hash de https://my.telegram.org (sección "API development tools")
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# IDs de Telegram autorizados, separados por coma (cada persona los obtiene con /miid)
ALLOWED_USERS=

# ---------- CMSV6 ----------
CMSV6_URL=http://47.88.25.163:8088
CMSV6_USER=
CMSV6_PASSWORD=
# Dónde buscar grabaciones, en orden: 2 = servidor de almacenamiento, 1 = equipo del vehículo
CMSV6_LOCATIONS=2,1

# ---------- Enlaces de descarga ----------
# Dirección pública del VPS con el puerto (la llena install.sh)
PUBLIC_URL=
# Clave para firmar enlaces (la genera install.sh)
LINK_SECRET=
LINK_HOURS=48
HTTP_PORT=8088

# ---------- Compresión ----------
# 23 = alta calidad, 28 = equilibrado, 32 = muy liviano
VIDEO_CRF=28
VIDEO_MAX_HEIGHT=720
VIDEO_PRESET=ultrafast
# 1 = si el AVI del FTP viene en H.264 se entrega sin recomprimir (instantáneo)
FTP_REMUX=1
MAX_CLIP_MINUTES=60
MAX_PARALLEL_JOBS=3
# Grabaciones en el bus: auto = pide solo los minutos necesarios cuando conviene;
# nunca = siempre baja el archivo completo; siempre = siempre por tramos
SEGMENT_MODE=auto
SEGMENT_STALL_SECONDS=120
# Tramos que se piden a la vez a un mismo bus (el bus los envía de a uno)
BUS_PARALLEL=2
# Método de descarga: auto (mide y usa el más rápido), ftp, reproduccion, tramos o directa
DOWNLOAD_METHOD=ftp
# Transmisiones de reproducción remota a la vez por bus (una por cámara)
BUS_STREAMS=4
# Subidas FTP a la vez por bus (el aplicativo permite 3) y segundos entre órdenes
FTP_PARALLEL=3
FTP_ORDER_GAP=2

# ---------- En vivo ----------
# Servidor de video de CMSV7 (vacío = se detecta solo; si no funciona: http://47.88.25.163:6604)
CMSV6_MEDIA_URL=
LIVE_SECONDS=15
LIVE_LINK_MINUTES=120

# ---------- Correo (enlaces de descarga por email) ----------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu cuenta y
# SMTP_PASSWORD = «contraseña de aplicación» (no la clave normal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Zona horaria de las grabaciones (para "hoy" y "ayer")
TZ=America/Santiago
