# ---------- Telegram ----------
# Token que te da @BotFather
TELEGRAM_BOT_TOKEN=
# api_id y api_hash de https://my.telegram.org (sección "API development tools")
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# IDs de Telegram autorizados, separados por coma (cada persona los obtiene con /miid)
ALLOWED_USERS=

# ---------- CMSV6 ----------
CMSV6_URL=http://47.88.25.163:8080
CMSV6_USER=
CMSV6_PASSWORD=
# Dónde buscar grabaciones, en orden: 2 = servidor de almacenamiento, 1 = equipo del vehículo
CMSV6_LOCATIONS=2,1

# ---------- Enlaces de descarga ----------
# Dirección pública del VPS con el puerto (la llena install.sh)
PUBLIC_URL=
# Clave para firmar enlaces (la genera install.sh)
LINK_SECRET=
LINK_HOURS=48
HTTP_PORT=8088

# ---------- Compresión ----------
# 23 = alta calidad, 28 = equilibrado, 32 = muy liviano
VIDEO_CRF=28
VIDEO_MAX_HEIGHT=720
VIDEO_PRESET=veryfast
MAX_CLIP_MINUTES=30
MAX_PARALLEL_JOBS=2

# Zona horaria de las grabaciones (para "hoy" y "ayer")
TZ=America/Bogota
